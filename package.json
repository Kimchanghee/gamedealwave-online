{
  "name": "gamedealwave",
  "version": "0.1.0",
  "private": true,
  "description": "Steam, PSN, Xbox game deal tracker (KR/EN/JA)",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "fetch-deals": "tsx scripts/fetch-deals.ts",
    "deploy": "npm run fetch-deals && npm run build && cdk deploy --require-approval never"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next-intl": "^3.20.0",
    "tailwindcss": "^3.4.13"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@aws-sdk/client-dynamodb": "^3.665.0",
    "@aws-sdk/lib-dynamodb": "^3.665.0",
    "aws-cdk-lib": "^2.160.0"
  }
}
